{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-game",
      "!**/node_modules",
      "!tools/lint-boundaries/fixtures",
      "!games/*/source",
      "!games/*/records",
      "!starter-kit",
      "!starter-character",
      "!starter-sprites",
      "!tools/cli/test/fixtures/keep/records/sprite",
      "!tools/cli/test/fixtures/deck/records/sprite",
      "!tools/cli/test/fixtures/deck/records/tileset",
      "!tools/cli/test/fixtures/boarding/records/sprite",
      "!tools/cli/test/fixtures/boarding/records/tileset",
      "!tools/cli/test/fixtures/tower/records/sprite",
      "!tools/cli/test/fixtures/tower/records/room",
      "!tools/cli/test/fixtures/moor"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tools/lint-boundaries/test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
