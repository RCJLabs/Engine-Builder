{
  "name": "@eb/editor",
  "private": true,
  "version": "0.0.1",
  "description": "The Engine-Builder editor: an installable PWA for PC, tablet and phone.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "icons": "node scripts/icons.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@eb/compiler": "workspace:*",
    "@eb/core": "workspace:*",
    "@eb/kits": "workspace:*",
    "@eb/platform": "workspace:*",
    "@eb/schema": "workspace:*",
    "@eb/script": "workspace:*",
    "@lezer/highlight": "1.2.5",
    "@preact/signals": "2.11.3",
    "dockview": "8.5.1",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@preact/preset-vite": "2.10.6",
    "fake-indexeddb": "6.2.5",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1"
  }
}
