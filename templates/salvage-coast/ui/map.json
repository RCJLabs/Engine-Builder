{
  "title": "Map",
  "shows": ["at-sea"],
  "top": {
    "widget": "stack",
    "direction": "row",
    "justify": "between",
    "wrap": true,
    "children": [
      {
        "widget": "text",
        "text": "{economy.amount(resource: coin)} Coin"
      },
      {
        "widget": "text",
        "text": "{economy.amount(resource: debt)} Debt"
      },
      {
        "widget": "text",
        "text": "{economy.amount(resource: stores)} Stores"
      }
    ]
  },
  "main": {
    "widget": "stack",
    "gap": 2,
    "children": [
      {
        "widget": "text",
        "text": "{map.name}",
        "style": "heading"
      },
      {
        "widget": "map",
        "empty": "No map yet."
      },
      {
        "widget": "log",
        "lines": 3,
        "label": "Lately",
        "empty": "Nothing has happened yet."
      }
    ]
  },
  "bottom": {
    "widget": "stack",
    "direction": "row",
    "justify": "end",
    "wrap": true,
    "children": [
      {
        "widget": "button",
        "label": "Inventory",
        "action": {
          "open": "inventory"
        }
      },
      {
        "widget": "button",
        "label": "Journal",
        "action": {
          "open": "journal"
        }
      },
      {
        "widget": "button",
        "label": "Codex",
        "action": {
          "open": "codex"
        }
      },
      {
        "widget": "button",
        "label": "Credits",
        "action": {
          "open": "credits"
        }
      }
    ]
  },
  "ambience": "sea"
}
