{
  "title": "The tower at night",
  "shows": ["night"],
  "top": {
    "widget": "stack",
    "direction": "row",
    "justify": "between",
    "children": [
      {
        "widget": "text",
        "text": "{time.clock}",
        "style": "heading"
      },
      {
        "widget": "text",
        "text": "The bell hasn’t rung.",
        "shows-when": "not flag.on(bell-rung)"
      },
      {
        "widget": "text",
        "text": "The bell has rung.",
        "shows-when": "flag.on(bell-rung)"
      }
    ]
  },
  "main": {
    "widget": "space",
    "space": "tower",
    "label": "The tower at night"
  },
  "bottom": {
    "widget": "stack",
    "direction": "row",
    "justify": "between",
    "children": [
      {
        "widget": "stack",
        "direction": "column",
        "children": [
          {
            "widget": "text",
            "text": "The warden is in the chapel.",
            "shows-when": "world.room(space: tower, of: wynn) == chapel"
          },
          {
            "widget": "text",
            "text": "The warden is in the crypt.",
            "shows-when": "world.room(space: tower, of: wynn) == crypt"
          },
          {
            "widget": "text",
            "text": "The warden is in the hall.",
            "shows-when": "world.room(space: tower, of: wynn) == hall"
          }
        ]
      },
      {
        "widget": "button",
        "label": "Wait an hour",
        "action": {
          "take": "tower/wait"
        }
      }
    ]
  }
}
