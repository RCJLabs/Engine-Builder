{
  "lines": [
    { "on": "time/day-started", "say": "Day {.day} begins.", "to": "log" },
    { "on": "hut/carried", "say": "You carry a load up from the village.", "to": "log" },
    { "on": "hut/visited", "where": { "who": "greta" }, "say": "You go down to see Greta.", "to": "log" },
    { "on": "hut/visited", "where": { "who": "anselm" }, "say": "You look in on Anselm.", "to": "log" },
    { "on": "inventory/gained", "say": "{.item} ×{.count} into the bag" },
    { "on": "economy/changed", "where": { "resource": "coins" }, "say": "Coins: {.by}", "to": "log" },
    { "on": "factions/standing-changed", "say": "{.faction}: {.by}", "to": "log" },
    { "on": "quests/started", "say": "In the journal: {.quest}" },
    { "on": "quests/done", "say": "Done: {.quest}" },
    { "on": "quests/failed", "say": "Failed: {.quest}. {.why}" },
    { "on": "hut/closed", "say": "The hut is shut for the winter." }
  ]
}
