{
  "title": "The moor",
  "shows": [
    "out"
  ],
  "top": {
    "widget": "stack",
    "children": [
      {
        "widget": "text",
        "text": "Walk the road north to the cairn.",
        "style": "heading",
        "shows-when": "not flag.on(cairn-seen)"
      },
      {
        "widget": "text",
        "text": "The cairn is reached.",
        "style": "heading",
        "shows-when": "flag.on(cairn-seen)"
      },
      {
        "widget": "text",
        "text": "Lantern {inventory.count(item: lantern)}"
      }
    ]
  },
  "main": {
    "widget": "space",
    "label": "The moor"
  },
  "bottom": {
    "widget": "stack",
    "direction": "row",
    "justify": "end",
    "children": [
      {
        "widget": "button",
        "label": "Rest a while",
        "action": {
          "take": "moor/rest"
        }
      }
    ]
  }
}
