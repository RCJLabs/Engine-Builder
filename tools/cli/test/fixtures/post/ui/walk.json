{
  "title": "The post",
  "shows": ["out"],
  "top": {
    "widget": "stack",
    "children": [
      {
        "widget": "text",
        "text": "Coin {economy.amount(resource: coin)} · Day {time.day}",
        "style": "heading"
      },
      {
        "widget": "text",
        "text": "Hild has {economy.purse(actor: hild, resource: coin)} coin"
      }
    ]
  },
  "main": {
    "widget": "space"
  },
  "bottom": {
    "widget": "stack",
    "direction": "row",
    "justify": "end",
    "children": [
      {
        "widget": "button",
        "label": "Wait a day",
        "action": {
          "take": "post/wait"
        }
      }
    ]
  }
}
