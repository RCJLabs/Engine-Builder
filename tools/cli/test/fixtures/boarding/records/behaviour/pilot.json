{
  "name": "The pilot's rounds",
  "description": "Between the bridge and the engines; to the helm when the alarm sounds.",
  "do": {
    "first": [
      {
        "if": "flag.on(alarm)",
        "do": {
          "travel": "bridge"
        }
      },
      {
        "do": {
          "patrol": ["bridge", "engines"],
          "dwell": {
            "minutes": 10
          }
        }
      }
    ]
  }
}
