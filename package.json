{
  "name": "engine-builder",
  "private": true,
  "version": "0.0.1",
  "description": "A browser-based game engine and editor: worlds, missions, scripts, menus and UI, on PC or phone.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @eb/editor dev",
    "eb": "node tools/cli/src/cli.ts",
    "build": "pnpm --filter @eb/editor build && pnpm --filter @eb/spike-3d build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tests.json",
    "lint": "biome check . && node tools/lint-boundaries/src/cli.ts",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
