{
  "//": "Tests run in Node and may use its APIs, so they are typechecked here rather than under the pure package configs.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "apps/editor/e2e/**/*.ts",
    "apps/editor/test/styles.d.ts",
    "apps/editor/test/vite.d.ts",
    "packages/ui/src/audio/zzfx-package.d.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules", "**/dist"]
}
