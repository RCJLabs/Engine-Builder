{
  "title": "The crew",
  "modal": true,
  "main": {
    "widget": "stack",
    "children": [
      {
        "widget": "text",
        "text": "The crew",
        "style": "heading"
      },
      {
        "widget": "text",
        "text": "{roster.count} aboard, room for {flag.number(flag: room)}",
        "style": "caption"
      },
      {
        "widget": "panel",
        "children": [
          {
            "widget": "text",
            "text": "{crew.member(place: 1)}",
            "style": "heading"
          },
          {
            "widget": "text",
            "text": "{crew.hp(place: 1)} HP · {crew.about(place: 1)}"
          }
        ],
        "shows-when": "roster.count >= 1"
      },
      {
        "widget": "panel",
        "children": [
          {
            "widget": "text",
            "text": "{crew.member(place: 2)}",
            "style": "heading"
          },
