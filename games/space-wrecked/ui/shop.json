{
  "title": "The shop",
  "shows": ["shopping"],
  "modal": true,
  "top": {
    "widget": "stack",
    "children": [
      {
        "widget": "text",
        "text": "{shop.name}",
        "style": "heading"
      },
      {
        "widget": "text",
        "text": "{economy.amount(resource: credits)} credits"
      }
    ],
    "direction": "row",
    "justify": "between",
    "wrap": true
  },
  "main": {
    "widget": "tabs",
    "tabs": [
      {
        "label": "Buy",
        "children": [
          {
            "widget": "list",
            "of": "shelf",
            "empty": "The shelves are bare.",
            "item": {
              "widget": "button",
              "label": "{.name}: {.price}",
              "action": {
                "take": "entry"
              }
            }
          }
        ]
      },
      {
        "label": "Sell",
        "children": [
          {
            "widget": "list",
            "of": "bag",
            "empty": "Nothing to sell.",
            "item": {
              "widget": "button",
              "label": "Sell {.name} for {.price}",
              "action": {
                "take": "entry"
              }
            }
          }
        ]
      }
    ]
  },
  "bottom": {
    "widget": "stack",
    "children": [
      {
        "widget": "button",
        "label": "Leave",
        "action": {
          "take": "economy/leave"
        }
      }
    ],
    "direction": "row",
    "justify": "end",
    "wrap": true
  }
}
