    "clients": {
      "kind": "list",
      "of": {
        "kind": "ref",
        "to": "client"
      },
      "min": 1,
      "label": "Clients"
    },
    "sites": {
      "kind": "list",
      "of": {
        "kind": "ref",
        "to": "site"
      },
      "min": 1,
      "label": "Sites"
    },
    "encounter": {
      "kind": "ref",
      "to": "encounter",
      "label": "Fought"
    },
    "against": {
      "kind": "ref",
      "to": "faction",
      "optional": true,
      "label": "Against",
      "description": "The side whose people the crew fights"
    },
    "pay": {
      "kind": "group",
      "fields": {
        "min": {
          "kind": "int",
          "min": 0,
          "label": "From"
        },
        "max": {
          "kind": "int",
          "min": 0,
          "label": "To"
        }
      },
      "label": "Pay"
    },
    "drops": {
      "kind": "group",
      "fields": {
        "chance": {
          "kind": "int",
          "min": 1,
          "max": 100,
