{
  "title": "Job",
  "description": "A job on act 1’s board: data/contracts.json’s jobs.",
  "nameField": "title",
  "fields": {
    "title": {
      "kind": "text",
      "min": 1,
      "label": "Title"
    },
    "mission": {
      "kind": "ref",
      "to": "mission",
      "label": "Mission"
    },
    "pitch": {
      "kind": "text",
      "min": 1,
      "multiline": true,
      "label": "Pitch",
      "description": "{client} and {site} are filled in as it goes on the board"
