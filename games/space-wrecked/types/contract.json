          "kind": "map",
          "key": {
            "kind": "ref",
            "to": "item"
          },
          "of": {
            "kind": "int",
            "min": 1
          },
          "label": "Parts, by weight"
        }
      },
      "optional": true,
      "label": "Drops",
      "description": "A part it pays with, by chance"
    },
    "once": {
      "kind": "bool",
      "optional": true,
      "label": "Once",
      "description": "Won once, it never comes back"
    },
    "quest": {
      "kind": "ref",
      "to": "quest",
      "optional": true,
      "label": "For quest",
      "description": "On the board only while the quest waits on it"
    },
    "crates": {
      "kind": "int",
      "min": 1,
      "optional": true,
      "label": "Crates"
